{
  "name": "matrix-deepseek-harness-companion",
  "displayName": "DeepSeek Harness Companion",
  "description": "Run the official DeepSeek Harness locally from VS Code.",
  "version": "0.4.8",
  "publisher": "matrix-oai-compatible-copilot-provider",
  "license": "MIT",
  "icon": "media/icon.png",
  "pricing": "Free",
  "galleryBanner": {
    "color": "#071A3D",
    "theme": "dark"
  },
  "qna": false,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "deepseek",
    "harness",
    "agent",
    "coding",
    "assistant",
    "ai"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Harness can edit files and run commands. Trust the workspace before starting it."
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "activationEvents": [
    "onView:deepseekHarness.chat"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "deepseekHarness.start",
        "title": "DeepSeek Harness: Start"
      },
      {
        "command": "deepseekHarness.stop",
        "title": "DeepSeek Harness: Stop"
      },
      {
        "command": "deepseekHarness.restart",
        "title": "DeepSeek Harness: Restart"
      },
      {
        "command": "deepseekHarness.openEditor",
        "title": "DeepSeek Harness: Open in Editor"
      },
      {
        "command": "deepseekHarness.setApiKey",
        "title": "DeepSeek Harness: Set DeepSeek API Key"
      },
      {
        "command": "deepseekHarness.copySelection",
        "title": "DeepSeek Harness: Copy Selection as Context"
      },
      {
        "command": "deepseekHarness.showLogs",
        "title": "DeepSeek Harness: Show Logs"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "deepseekHarness.copySelection",
          "when": "editorHasSelection",
          "group": "navigation@20"
        }
      ],
      "view/title": [
        {
          "command": "deepseekHarness.restart",
          "when": "view == deepseekHarness.chat",
          "group": "navigation@1"
        },
        {
          "command": "deepseekHarness.openEditor",
          "when": "view == deepseekHarness.chat",
          "group": "navigation@2"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "deepseekHarness",
          "title": "DeepSeek Harness",
          "icon": "media/deepseek.svg"
        }
      ]
    },
    "views": {
      "deepseekHarness": [
        {
          "type": "webview",
          "id": "deepseekHarness.chat",
          "name": "Chat"
        }
      ]
    },
    "configuration": {
      "title": "DeepSeek Harness",
      "properties": {
        "deepseekHarness.binaryPath": {
          "type": "string",
          "default": "",
          "description": "Path to the dsh executable. Leave empty to try dsh from PATH, then npx @deepseek-ai/dsh."
        },
        "deepseekHarness.dshHome": {
          "type": "string",
          "default": "",
          "description": "Optional DSH_HOME. Leave empty to use the official Harness default."
        },
        "deepseekHarness.launchWithNpx": {
          "type": "boolean",
          "default": true,
          "description": "Offer to download and run official @deepseek-ai/dsh through npx when dsh is not found."
        },
        "deepseekHarness.hidePreviewBadge": {
          "type": "boolean",
          "default": true,
          "description": "Hide the Preview badge in the embedded Harness interface. This does not change the upstream release status."
        }
      }
    }
  },
  "scripts": {
    "check": "node --check extension.js && node scripts/validate-publish.js --allow-local",
    "publish:check": "node scripts/validate-publish.js",
    "package": "npm run check && npx @vscode/vsce package",
    "publish": "npm run publish:check && npx @vscode/vsce publish"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.0"
  }
}
